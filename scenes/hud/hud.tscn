[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/hud/hud.gd" id="1_script"]

[node name="Hud" type="CanvasLayer"]
script = ExtResource("1_script")

[node name="Margem" type="MarginContainer" parent="."]
offset_right = 600.0
offset_bottom = 200.0
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 30

[node name="Linhas" type="VBoxContainer" parent="Margem"]
layout_mode = 2

[node name="Score" type="Label" parent="Margem/Linhas"]
layout_mode = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 48
text = "Score: 0"

[node name="Poder" type="Label" parent="Margem/Linhas"]
layout_mode = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 36
